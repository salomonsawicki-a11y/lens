{
  "manifest_version": 3,
  "name": "Lens — AI Reading Companion",
  "version": "2.3.0",
  "description": "Highlight any sentence and get an instant AI explanation — no account or API key needed on supported devices.",
  "author": "Salomon Noah Sawicki",
  "homepage_url": "https://salomonsawicki-a11y.github.io/lens/",
  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "webNavigation",
    "webRequest",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://*.workers.dev/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "action": {
    "default_title": "Lens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "explain-selection": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "Explain the current text selection"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "pdfjs/*",
        "content.js",
        "content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
